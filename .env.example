# The default mock provider works without credentials.
AI_ADVISOR_PROVIDER=mock
AI_ADVISOR_HOST=127.0.0.1
AI_ADVISOR_PORT=8766

# Real provider example (keep the actual key in a local .env or shell only).
AI_ADVISOR_BASE_URL=
AI_ADVISOR_API_KEY=
AI_ADVISOR_MODEL=
AI_ADVISOR_ASSET_ROOT=
AI_ADVISOR_TIMEOUT=120

# Local project library (media remains on this machine).
LAPIAN_WORKBENCH_HOST=127.0.0.1
LAPIAN_WORKBENCH_PORT=8765
LAPIAN_PROJECTS_ROOT=outputs/projects
LAPIAN_MAX_UPLOAD_GB=20
